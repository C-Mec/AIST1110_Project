{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run main.py (.conda)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}\\.conda\\python.exe",
      "program": "${workspaceFolder}\\main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PATH": "${workspaceFolder}\\.conda;${workspaceFolder}\\.conda\\Scripts;${workspaceFolder}\\.conda\\Library\\bin;${workspaceFolder}\\.conda\\DLLs;${env:PATH}"
      }
    }
  ]
}
