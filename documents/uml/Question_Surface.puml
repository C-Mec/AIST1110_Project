@startuml
title Question_Surface

skinparam classAttributeIconSize 0
hide circle
skinparam linetype ortho

class Question_Surface {
  +grid_surface: Grid_Surface
  +question: Question
  +overshade: bool
  +stage: str
  +current_player: Player | None
  +close_time: int | None
  +buzz_rect: Rect
  +session_time: int | None
  +timer_time: int | None
  +answer_duration: int
  +buzz_flash_start_time: int | None
  +bot_action: tuple[Player, Vec2, int] | None
  +submitted_answers: list[tuple[Player, int]]
  +option_rects: list[Rect]
  +interactive: bool
  -_frozen_timer_time: float
  ..
  +__init__(question: Question, grid_surface: Grid_Surface)
  +schedule_bot_action()
  +session_remaining_time(): float
  +draw(screen: Surface)
  +on_close()
  +time_update()
  +on_click(pos: Vec2, player: Player)
}

@enduml
