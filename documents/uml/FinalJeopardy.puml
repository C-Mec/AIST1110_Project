@startuml
title FinalJeopardy

skinparam classAttributeIconSize 0
hide circle
skinparam linetype ortho

class FinalJeopardy {
  +category: str
  +clue: str
  +option: list[str]
  +correct_option: str
  +confirmed: bool
  +input_text: str
  +active_box: bool
  +phase: str
  +no_wager_start: int | None
  +end_countdown: int | None
  +screen_w: int
  +screen_h: int
  +background: Surface
  +box_rect: Rect
  +confirm_button: Rect
  +answer_box: Rect
  +grid_area: Rect
  ..
  +__init__(dimension: Vec2, pos: Vec2, used_index: int)
  +handle_event(event)
  +on_click(pos: Vec2, player: Player)
  +wrap_text(text: str, font, max_width: int): list[str]
  -_confirm_wager()
  -_lock_answer()
  +draw(screen: Surface)
  +resize(new_dimension: Vec2)
}

@enduml
